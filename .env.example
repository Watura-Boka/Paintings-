# Environment example for the image backend

This file lists environment variables the server reads at runtime. Do NOT store secrets in version control — set them in your host (Render, Railway, etc.).

# Cloudinary (required for image signing to work)
CLOUDINARY_CLOUD_NAME=xlpzooiq
CLOUDINARY_API_KEY=759951758839177
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Firebase service account credentials
# Option A (recommended): set the service account JSON directly (raw JSON or base64-encoded) in this env var.
#   - For base64: set GOOGLE_SERVICE_ACCOUNT_JSON to the base64 of the service-account JSON file.
#   - For raw JSON: set GOOGLE_SERVICE_ACCOUNT_JSON to the raw JSON (single-line or multi-line) — some platforms require quoting.
# Example (DO NOT COMMIT):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Option B: provide a path to a JSON file on disk via GOOGLE_APPLICATION_CREDENTIALS (platform must support adding files).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Port (hosts often set this automatically)
PORT=3001
NODE_ENV=production
